local function updateESP()
    local origin = bombBody and bombBody.Position or camera.CFrame.Position
    for player, frame in pairs(espSquares) do
        local char = player.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        if not root or not hum or hum.Health <= 0 then
            frame.Visible = false
            continue
        end
        local dist = (root.Position - origin).Magnitude
        if dist > CFG.ScanRadius then
            frame.Visible = false
            continue
        end
        local sp, onScreen = camera:WorldToViewportPoint(root.Position)
        if not onScreen then
            frame.Visible = false
            continue
        end
        local size = math.clamp(3000 / math.max(dist, 10), 28, 110)
        frame.Size = UDim2.new(0, size, 0, size)
        frame.Position = UDim2.new(0, sp.X - size/2, 0, sp.Y - size/2)

        local isLocked = (lockedTarget == player)
        local stroke = frame:FindFirstChildOfClass("UIStroke")
        local infoBox = frame:FindFirstChildOfClass("Frame")
        if stroke then
            local color = isLocked and (orbitActive and CFG.OrbitColor or CFG.LockColor) or CFG.ThemeColor
            stroke.Color = color
            stroke.Thickness = isLocked and 2.5 or 1.5
        end
        if infoBox then
            local dl = infoBox:FindFirstChild("DistLbl")
            local nl = infoBox:FindFirstChild("NameLbl")
            if dl then dl.Text = string.format("%.0fm", dist) end
            if nl then
                local color = isLocked and (orbitActive and CFG.OrbitColor or CFG.LockColor) or CFG.ThemeColor
                nl.TextColor3 = color
            end
        end
        frame.Visible = true
    end
end

local function clearESP()
