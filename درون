local function shutdown()
    exitFPV(false)
    for _, c in ipairs(CONNECTIONS) do pcall(function() c:Disconnect() end) end
    CONNECTIONS = {}
    if sg then pcall(function() sg:Destroy() end); sg = nil end
    local lo = PG:FindFirstChild("VANTA_Drone")
    if lo then pcall(function() lo:Destroy() end) end
    if colorCorrection then colorCorrection:Destroy() end
    for _, s in pairs(soundCache) do pcall(function() s:Destroy() end) end
    soundCache = {}
    _G.VANTA_DRONE_SHUTDOWN = nil
end
