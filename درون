local function exitFPV(wasExplosion)
    if not active then return end
    active = false
    lockedTarget = nil
    orbitActive = false
    isLaunching = false
    zoomLevel = 1

    if bombBody and bombBody.Parent then
        bombBody.AssemblyLinearVelocity = Vector3.zero
        bombBody.AssemblyAngularVelocity = Vector3.zero
    end

    if bv then pcall(function() bv:Destroy() end); bv = nil end
    if bg then pcall(function() bg:Destroy() end); bg = nil end

    if dragPart and dragPart.Parent then
        pcall(function() DestroyGrab:FireServer(dragPart) end)
    end
    savedDrag = nil

    if wasExplosion and ui.impactFlash then
        playSystemSound("splat.wav", 0.7)
        ui.impactFlash.Visible = true
        task.delay(0.25, function()
            if ui.impactFlash then ui.impactFlash.Visible = false end
        end)
    else
        playSystemSound("button.wav", 1)
    end

    showBombVisuals()
    showGameButtons()
    showGrabLine()
    clearESP()

    pcall(function()
        camera.CameraType = savedCam.type or Enum.CameraType.Custom
        camera.FieldOfView = savedCam.fov or 70
        local hum = LP.Character and LP.Character:FindFirstChildOfClass("Humanoid")
        if hum then camera.CameraSubject = hum
        elseif savedCam.subject then camera.CameraSubject = savedCam.subject end
    end)

    bomb = nil; bombBody = nil; dragPart = nil
    lastPos = nil
    UIS.MouseBehavior = Enum.MouseBehavior.Default

    if thermalActive then
        thermalActive = false
        if colorCorrection then colorCorrection.Enabled = false end
    end

    if sg then sg.Enabled = false end
    if ui.quickBtn then ui.quickBtn.Visible = true end
end

local function enterFPV(model, grabParts, dragP, body)
    bomb = model; dragPart = dragP; bombBody = body

    savedDrag = {}
    for _, c in ipairs(dragP:GetChildren()) do
        if c:IsA("AlignPosition") or c:IsA("AlignOrientation") or c:IsA("BodyMover") then
            savedDrag[c] = c.Enabled
            c.Enabled = false
        end
    end

    killMovers(bombBody)

    local look = camera.CFrame.LookVector
    yaw   = math.deg(math.atan2(-look.X, -look.Z))
    pitch = 18
    currentRoll = 0
    lastYaw = yaw
    smoothedTurnRate = 0
    dashEndTime = 0
    flightStartTime = tick()
    orbitActive = false
    orbitAngle = 0
    zoomLevel = 1

    isLaunching = true
    launchEndTime = tick() + CFG.LaunchDuration

    if persistentTarget and persistentTarget.Parent and persistentTarget.Character then
        local hum = persistentTarget.Character:FindFirstChildOfClass("Humanoid")
        if hum and hum.Health > 0 then
            lockedTarget = persistentTarget
            playSystemSound("electronicpingshort.wav", 1.8)
        else
            persistentTarget = nil
            lockedTarget = nil
        end
    else
        lockedTarget = nil
    end

    bv = Instance.new("BodyVelocity")
    bv.Name = "VantaDroneBV"
    bv.MaxForce = Vector3.new(1e8, 1e8, 1e8)
    bv.Velocity = Vector3.new(0, CFG.LaunchUpSpeed, 0)
    bv.Parent = bombBody

    bg = Instance.new("BodyGyro")
    bg.Name = "VantaDroneBG"
    bg.MaxTorque = Vector3.new(1e8, 1e8, 1e8)
    bg.P = CFG.GyroP
    bg.D = CFG.GyroD
    bg.CFrame = bombBody.CFrame
    bg.Parent = bombBody

    model.PrimaryPart = bombBody
    lastPos = bombBody.Position
    currentSpeed = CFG.Speed

    savedCam.type = camera.CameraType
    savedCam.subject = camera.CameraSubject
    savedCam.fov = camera.FieldOfView
    camera.CameraType = Enum.CameraType.Scriptable

    clearESP()
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP then createESPSquare(plr) end
    end

    hideGameButtons()
    hideGrabLine()
    applyCamMode()

    active = true
    if sg then 
        sg.Enabled = true
        ui.hudContainer.Visible = true
        if ui.impactFlash then ui.impactFlash.Visible = false end
    end
    if ui.quickBtn then ui.quickBtn.Visible = false end
    playSystemSound("snap.wav", 1.2)
end

addConn(UIS.InputBegan:Connect(function(input, gpe)
    if not active or gpe then return end
    if input.UserInputType == Enum.UserInputType.Touch then steeringTouch = true end
end))

addConn(UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch then steeringTouch = false end
end))

addConn(UIS.InputChanged:Connect(function(input)
    if not active then return end
    local dx, dy = 0, 0
    if input.UserInputType == Enum.UserInputType.Touch and steeringTouch then
        dx, dy = input.Delta.X * (CFG.TurnSensTouch / zoomLevel), input.Delta.Y * (CFG.TurnSensTouch / zoomLevel)
    elseif input.UserInputType == Enum.UserInputType.MouseMovement then
        local d = UIS:GetMouseDelta()
        dx, dy = d.X * (CFG.TurnSensMouse / zoomLevel), d.Y * (CFG.TurnSensMouse / zoomLevel)
    end

    if (math.abs(dx) > CFG.SwipeUnlockLimit or math.abs(dy) > CFG.SwipeUnlockLimit) then
        if lockedTarget or orbitActive then
            lockedTarget = nil
            persistentTarget = nil
            orbitActive = false
            playSystemSound("button.wav", 0.7)
        end
    end

    if not lockedTarget and not orbitActive then
        yaw   = yaw - dx
        pitch = math.clamp(pitch - dy, -CFG.PitchLimit, CFG.PitchLimit)
    end
end))

addConn(RunService.RenderStepped:Connect(function(dt)
    if holdingPlus then
        holdTimer = holdTimer + dt
        if holdTimer > 0.15 then
            CFG.Speed = math.min(CFG.MaxSpeed, CFG.Speed + math.floor(450 * dt))
            if ui.speedLbl then ui.speedLbl.Text = tostring(math.floor(CFG.Speed)) end
        end
    elseif holdingMinus then
        holdTimer = holdTimer + dt
        if holdTimer > 0.15 then
            CFG.Speed = math.max(CFG.MinSpeed, CFG.Speed - math.floor(450 * dt))
            if ui.speedLbl then ui.speedLbl.Text = tostring(math.floor(CFG.Speed)) end
        end
    else
        holdTimer = 0
    end

    if not active then
        local model, gp, dp, bp = getBombMissile()
        if model and bp then enterFPV(model, gp, dp, bp) end
        return
    end

    if not bomb or not bomb.Parent or not bombBody or not bombBody.Parent then
        exitFPV(false); return
    end

    local now = tick()
    if (now - lastOwnerTick) > 0.3 then
        lastOwnerTick = now
        pcall(function() bombBody:SetNetworkOwner(LP) end)
    end

    local curPos = bombBody.Position
    local targetSpeed = CFG.Speed

    if isLaunching then
        if now >= launchEndTime then
            isLaunching = false
        else
            targetSpeed = CFG.Speed * 0.85
        end
    end

    if lockedTarget and not isLaunching then
        local char = lockedTarget.Character
        local hum  = char and char:FindFirstChildOfClass("Humanoid")
        local hrp  = char and char:FindFirstChild("HumanoidRootPart")
        if not char or not hum or hum.Health <= 0 or not hrp then
            lockedTarget = nil
            persistentTarget = nil
            orbitActive = false
        else
            if orbitActive then
                targetSpeed = math.min(CFG.MaxSpeed, CFG.Speed)
                orbitAngle = orbitAngle + dt * (CFG.OrbitSpeed / CFG.OrbitRadius)
                local offset = Vector3.new(math.cos(orbitAngle) * CFG.OrbitRadius, 18, math.sin(orbitAngle) * CFG.OrbitRadius)
                local orbitDest = hrp.Position + offset
                local delta = orbitDest - curPos
                if delta.Magnitude > 0.2 then
                    local toOrbit = delta.Unit
                    local desYaw   = math.deg(math.atan2(-toOrbit.X, -toOrbit.Z))
                    local desPitch = math.deg(math.asin(math.clamp(toOrbit.Y, -1, 1)))
                    local diffYaw = ((desYaw - yaw + 180) % 360) - 180
                    local diffPitch = desPitch - pitch
                    yaw = yaw + (diffYaw * math.min(1, dt * 18))
                    pitch = math.clamp(pitch + (diffPitch * math.min(1, dt * 18)), -CFG.PitchLimit, CFG.PitchLimit)
                end
            else
                targetSpeed = math.min(CFG.MaxSpeed, math.max(CFG.Speed * 1.5, CFG.TerminalSpeed))
                local dist = (hrp.Position - curPos).Magnitude
                local leadTime = math.clamp(dist / math.max(currentSpeed, 120), 0, CFG.MaxLeadTime)
                local targetVel = hrp.AssemblyLinearVelocity or Vector3.zero
                local aimPoint = (hrp.Position + Vector3.new(0, 0.4, 0)) + (targetVel * leadTime)

                local delta = aimPoint - curPos
                if delta.Magnitude > 0.2 then
                    local toTarget = delta.Unit
                    local desYaw   = math.deg(math.atan2(-toTarget.X, -toTarget.Z))
                    local desPitch = math.deg(math.asin(math.clamp(toTarget.Y, -1, 1)))

                    local diffYaw = ((desYaw - yaw + 180) % 360) - 180
                    local diffPitch = desPitch - pitch

                    local turnPower = math.min(1, dt * CFG.GuideGain)
                    yaw = yaw + (diffYaw * turnPower)
                    pitch = math.clamp(pitch + (diffPitch * turnPower), -CFG.PitchLimit, CFG.PitchLimit)
                end
            end
        end
    end

    if now < dashEndTime then
        targetSpeed = math.min(CFG.MaxSpeed, CFG.Speed + CFG.BoostDash)
        boostActive = true
    else
        boostActive = (lockedTarget ~= nil and not orbitActive)
    end

    if currentSpeed < targetSpeed then
        currentSpeed = math.min(targetSpeed, currentSpeed + CFG.LinearAccel * dt)
    else
        currentSpeed = math.max(targetSpeed, currentSpeed - CFG.LinearDecel * dt)
    end

    local yawDelta = ((yaw - lastYaw + 180) % 360) - 180
    lastYaw = yaw
    local instantTurn = yawDelta / math.max(dt, 0.001)
    smoothedTurnRate = smoothedTurnRate + (instantTurn - smoothedTurnRate) * math.min(1, dt * 10)
    local goalRoll = math.clamp(smoothedTurnRate * CFG.BankFactor, -CFG.MaxBankAngle, CFG.MaxBankAngle)
    currentRoll = currentRoll + (goalRoll - currentRoll) * math.min(1, dt * CFG.AngularDamp)

    local baseRot = CFrame.Angles(0, math.rad(yaw), 0) * CFrame.Angles(math.rad(pitch), 0, 0)
    local dir = baseRot.LookVector
    local upVec = baseRot.UpVector
    local rightVec = baseRot.RightVector
    local rolledUp = (upVec * math.cos(math.rad(currentRoll))) + (rightVec * math.sin(math.rad(currentRoll)))
    local orientedCF = CFrame.fromMatrix(curPos, dir, rolledUp)

    if isLaunching then
        bv.Velocity = Vector3.new(0, CFG.LaunchUpSpeed, 0) + (dir * (currentSpeed * 0.4))
    else
        local bob = Vector3.new(0, math.sin(now * 8) * CFG.HoverBobble, 0)
        bv.Velocity = (dir * currentSpeed) + bob
    end
    bg.CFrame = orientedCF

    local speedRatio = math.clamp(currentSpeed / CFG.MaxSpeed, 0, 1)
    local baseCamFOV = (CFG.CamMode == "FPV") and (CFG.FOV_FPV_Base + (CFG.FOV_FPV_Max - CFG.FOV_FPV_Base) * speedRatio) or CFG.FOV_TPV
    local wantFOV = baseCamFOV / zoomLevel
    camera.FieldOfView = camera.FieldOfView + (wantFOV - camera.FieldOfView) * math.min(1, dt * 8)

    local shakeAmt = speedRatio * CFG.ShakeIntensity
    shakeX = (math.random() - 0.5) * shakeAmt
    shakeY = (math.random() - 0.5) * shakeAmt

    local pitchCamOffset = math.clamp(pitch * 0.02, -0.4, 0.4)
    if CFG.CamMode == "FPV" then
        local camPos = curPos + dir * CFG.CamNoseOffset
        local targetCF = CFrame.new(camPos, camPos + dir)
        camera.CFrame = targetCF * CFrame.Angles(shakeY * 0.02 + pitchCamOffset, shakeX * 0.02, math.rad(-currentRoll * 0.45))
    else
        local camPos = curPos - dir * CFG.CamBack_TPV + rolledUp * CFG.CamUp_TPV
        camera.CFrame = CFrame.new(camPos, curPos + dir * 30)
    end

    updateESP()

    sharedRayParams.FilterDescendantsInstances = {bomb, LP.Character}
    local centerColor = CFG.ThemeColor
    local aimHit = workspace:Raycast(camera.CFrame.Position, camera.CFrame.LookVector * 500, sharedRayParams)
    if aimHit and aimHit.Instance then
        local targetModel = aimHit.Instance:FindFirstAncestorOfClass("Model")
        local playerFound = targetModel and Players:GetPlayerFromCharacter(targetModel)
        if playerFound and playerFound ~= LP then centerColor = CFG.AlertColor end
    end
    if lockedTarget then centerColor = orbitActive and CFG.OrbitColor or CFG.LockColor end

    local bracketScale = lockedTarget and 28 or 24
    if ui.crosshairFrame then
        ui.crosshairFrame.Size = ui.crosshairFrame.Size:Lerp(UDim2.new(0, bracketScale*2, 0, bracketScale*2), dt * 10)
    end

    if ui.reticleBracket then
        for _, b in ipairs(ui.reticleBracket) do b.BackgroundColor3 = centerColor end
    end
    if ui.centerDot then ui.centerDot.BackgroundColor3 = centerColor end

    if ui.fpmPip and bv then
        local actualVel = bv.Velocity
        if actualVel.Magnitude > 10 then
            local sp, onScreen = camera:WorldToViewportPoint(curPos + actualVel.Unit * 30)
            if onScreen then
                ui.fpmPip.Visible = true
                ui.fpmPip.Position = UDim2.new(0, sp.X - 5, 0, sp.Y - 5)
            else
                ui.fpmPip.Visible = false
            end
        else
            ui.fpmPip.Visible = false
        end
    end

    local fwdRay = workspace:Raycast(curPos, dir * 35, sharedRayParams)
    if fwdRay and (now - lastWarnSound > 0.25) and not isLaunching then
        lastWarnSound = now
        playSystemSound("electronicpingshort.wav", 2.2)
    end

    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LP and plr.Character then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum then
                local last = lastKnownHealth[plr]
                if last and last > 0 and hum.Health <= 0 then
                    if bombBody and (plr.Character:GetPivot().Position - bombBody.Position).Magnitude < 120 then
                        killCount = killCount + 1
                        playSystemSound("bell.wav", 1.2)
                    end
                end
                lastKnownHealth[plr] = hum.Health
            end
        end
    end

    if lastPos and not isLaunching then
        local seg = curPos - lastPos
        if seg.Magnitude > 0.05 then
            local hit = workspace:Raycast(lastPos, seg, sharedRayParams)
            if hit then
                exitFPV(true)
                return
            end
        end
    end
    lastPos = curPos

    if ui.horizonLine then
        ui.horizonLine.Rotation = -currentRoll
        ui.horizonLine.Position = UDim2.new(0.5, 0, 0.5, math.clamp(pitch * 1.5, -90, 90))
    end

    if ui.compassLbl then
        local normYaw = (math.floor(-yaw) % 360 + 360) % 360
        local heading = "N"
        if normYaw >= 338 or normYaw < 23 then heading = "N"
        elseif normYaw >= 23 and normYaw < 68 then heading = "NE"
        elseif normYaw >= 68 and normYaw < 113 then heading = "E"
        elseif normYaw >= 113 and normYaw < 158 then heading = "SE"
        elseif normYaw >= 158 and normYaw < 203 then heading = "S"
        elseif normYaw >= 203 and normYaw < 248 then heading = "SW"
        elseif normYaw >= 248 and normYaw < 293 then heading = "W"
        elseif normYaw >= 293 and normYaw < 338 then heading = "NW" end
        ui.compassLbl.Text = string.format("[%s %03d°]", heading, normYaw)
    end

    if ui.hudTelemetry then
        local bat = math.max(11.4, 16.8 - ((tick() - flightStartTime) * 0.03))
        local targetText = "SEARCHING"
        if isLaunching then
            targetText = "CATAPULT LAUNCH"
        elseif orbitActive and lockedTarget then
            targetText = "ORBIT RECON // " .. string.upper(lockedTarget.Name)
        elseif lockedTarget then
            targetText = "TERMINAL LOCK // " .. string.upper(lockedTarget.Name)
        end
        ui.hudTelemetry.Text = string.format("SPD %04d | ALT %03d | BAT %.1fV | %s | MAG: %dX | KILLS: %d", math.floor(currentSpeed), math.floor(curPos.Y), bat, targetText, zoomLevel, killCount)
        ui.hudTelemetry.TextColor3 = lockedTarget and (orbitActive and CFG.OrbitColor or CFG.LockColor) or CFG.ThemeColor
    end
end))

