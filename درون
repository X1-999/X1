local soundCache = {}
local function playSystemSound(soundName, pitch)
    task.spawn(function()
        local s = soundCache[soundName]
        if not s or not s.Parent then
            s = Instance.new("Sound")
            s.SoundId = "rbxasset://sounds/" .. soundName
            s.Volume = 0.85
            s.Parent = workspace
            soundCache[soundName] = s
        end
        s.Pitch = pitch or 1
        s:Play()
    end)
end

local function addConn(c) table.insert(CONNECTIONS, c); return c end

local function getBombMissile()
    local gp = workspace:FindFirstChild("GrabParts")
    if not gp then return nil end
    local grabPart = gp:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld then return nil end
    local p = weld.Part1
    if not p or not p:IsA("BasePart") then return nil end
    local model = p:FindFirstAncestorOfClass("Model")
    if not model or model.Name ~= CFG.BombName then return nil end
    local body = model:FindFirstChild(CFG.BodyName, true)
    if not body then return nil end
    return model, gp, grabPart, body
end

local function killMovers(part)
    for _, c in ipairs(part:GetChildren()) do
        if c:IsA("BodyMover") or c:IsA("Constraint") or c:IsA("LinearVelocity") or c:IsA("AlignOrientation") then
            pcall(function() c:Destroy() end)
        end
    end
end

local function quickSpawnAndGrab()
    local char = LP.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end
    local spawnCF = hrp.CFrame * CFrame.new(0, 3, -4)
    local ok = pcall(function()
        SpawnToyRF:InvokeServer(CFG.BombName, spawnCF, Vector3.zero)
    end)
    if not ok then return false end

    task.spawn(function()
        local folder = workspace:WaitForChild(LP.Name.."SpawnedInToys", 5)
        if not folder then return end
        local bombModel
        local t0 = tick()
        while tick() - t0 < 2.5 do
            bombModel = folder:FindFirstChild(CFG.BombName)
            if bombModel then break end
            task.wait(0.04)
        end
        if not bombModel then return end
        task.wait(0.06)
        local body = bombModel:FindFirstChild(CFG.BodyName, true) or bombModel.PrimaryPart
        if not body then return end
        pcall(function() CreateGrabLine:FireServer(body, CFrame.new()) end)
        task.wait(0.04)
        local hrp2 = LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
        if hrp2 then
            local lookCF = CFrame.lookAt(hrp2.Position, body.Position)
            pcall(function() SetNetOwner:FireServer(body, lookCF) end)
            task.wait(0.04)
            pcall(function() SetNetOwner:FireServer(body, lookCF) end)
            task.wait(0.04)
            pcall(function() ExtendLine:FireServer(6) end)
        end
    end)
    return true
end

local function hideBombVisuals()
    if not bomb then return end
    hiddenParts = {}
    for _, d in ipairs(bomb:GetDescendants()) do
        if d:IsA("BasePart") then
            hiddenParts[d] = { t = d.Transparency, q = d.CanQuery }
            d.Transparency = 1
            d.CanQuery = false
        end
    end
end

local function showBombVisuals()
    for part, data in pairs(hiddenParts) do
        if part and part.Parent then
            part.Transparency = data.t
            part.CanQuery = data.q
        end
    end
    hiddenParts = {}
end

local function hideGameButtons()
    hiddenButtons = {}
    local function scan(g)
        if not g then return end
        for _, d in ipairs(g:GetDescendants()) do
            if d:IsA("ImageButton") or d:IsA("TextButton") then
                local p = d.Parent
                if p and p.Visible then
                    hiddenButtons[p] = true
                    p.Visible = false
                end
            end
        end
    end
    scan(PG:FindFirstChild("ContextActionGui"))
    scan(PG:FindFirstChild("TouchGui"))
    scan(PG:FindFirstChild("TouchControlFrame"))
end

local function showGameButtons()
    for btn, _ in pairs(hiddenButtons) do
        if btn and btn.Parent then pcall(function() btn.Visible = true end) end
    end
    hiddenButtons = {}
end

local function hideGrabLine()
    hiddenLineParts = {}
    local function mark(d)
        if d:IsA("BasePart") and d ~= bombBody then
            if hiddenLineParts[d] == nil then
                hiddenLineParts[d] = { t = d.Transparency }
                d.Transparency = 1
            end
        elseif d:IsA("Beam") or d:IsA("Trail") then
            if hiddenLineParts[d] == nil then
                hiddenLineParts[d] = { e = d.Enabled }
                d.Enabled = false
            end
        end
    end
    local gp = workspace:FindFirstChild("GrabParts")
    if gp then
        for _, d in ipairs(gp:GetDescendants()) do mark(d) end
        addConn(gp.DescendantAdded:Connect(function(d) if active then mark(d) end end))
    end
end

local function showGrabLine()
    for obj, data in pairs(hiddenLineParts) do
        if obj and obj.Parent then
            if data.t then pcall(function() obj.Transparency = data.t end) end
            if data.e then pcall(function() obj.Enabled = data.e end) end
        end
    end
    hiddenLineParts = {}
end

local function applyCamMode()
    if not bomb then return end
    if CFG.CamMode == "FPV" then hideBombVisuals() else showBombVisuals() end
end

