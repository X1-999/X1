local function switchTab(tabName)
    activeTab = tabName
    tabLogs.TextColor3 = tabName == "LOGS" and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(160, 160, 175)
    tabFavs.TextColor3 = tabName == "FAVS" and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(160, 160, 175)
    tabInsp.TextColor3 = tabName == "INSP" and Color3.fromRGB(0, 255, 170) or Color3.fromRGB(160, 160, 175)

    if tabName == "INSP" then
        logsContainer.Visible = false
        inspectorContainer.Visible = true
    else
        inspectorContainer.Visible = false
        logsContainer.Visible = true
        for _, p in ipairs(order) do
            local rec = logs[p]
            if rec and rec.row then
                if tabName == "FAVS" then
                    rec.row.Visible = favorites[p] == true
                else
                    rec.row.Visible = (not blocked[p]) and (filterType == "ALL" or (filterType == "EVENT" and rec.method == "FireServer") or (filterType == "FUNC" and rec.method == "InvokeServer")) and (filterText == "" or p:lower():find(filterText:lower(), 1, true) ~= nil)
                end
            end
        end
    end
end

