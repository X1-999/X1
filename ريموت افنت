-- ═══ Serializer & Helpers ═══
local function serializeValue(v, depth)
    depth = depth or 0
    if depth > 3 then return "..." end
    local t = typeof(v)
    if t == "Instance" then
        local ok, name = pcall(function() return v:GetFullName() end)
        return ok and name or ("[" .. v.ClassName .. "]")
    elseif t == "string" then
        return '"' .. v:gsub('"', '\\"') .. '"'
    elseif t == "Vector3" then
        return string.format("Vector3.new(%.2f, %.2f, %.2f)", v.X, v.Y, v.Z)
    elseif t == "CFrame" then
        local p = v.Position
        return string.format("CFrame.new(%.2f, %.2f, %.2f)", p.X, p.Y, p.Z)
    elseif t == "table" then
        local parts = {}
        for k, val in pairs(v) do
            local kStr = type(k) == "number" and "" or (tostring(k) .. " = ")
            table.insert(parts, kStr .. serializeValue(val, depth + 1))
        end
        return "{" .. table.concat(parts, ", ") .. "}"
    else
        return tostring(v)
    end
end

local function getDetailedTypes(packed)
    if not packed then return "لا توجد أرجومنتات" end
    local n = packed.n or #packed
    if n == 0 then return "لا توجد أرجومنتات (Void)" end
    local lines = {}
    for i = 1, n do
        local val = packed[i]
        local tStr = typeof(val)
        table.insert(lines, string.format("[%d] (%s): %s", i, tStr, serializeValue(val)))
    end
    return table.concat(lines, "\n")
end

local function parseArgsString(str)
    if not str or str == "" or str == "nil" then return {} end
    local fn = loadstring("return {" .. str .. "}")
    if fn then
        local ok, res = pcall(fn)
        if ok and type(res) == "table" then return res end
    end
    return nil
end

local function generateAIPrompt(rec)
    if not rec then return "" end
    local argsFormatted = getDetailedTypes(rec.lastArgs)
    local prompt = string.format([[
[Roblox Remote Event Analysis Request]
--------------------------------------------------
Remote Path: %s
Class Type: %s
Invocation Method: %s
Argument Count: %d

Detailed Arguments Breakdown:
%s

--------------------------------------------------
Task for AI:
1. Explain what this RemoteEvent/RemoteFunction likely controls in the game based on its name and arguments.
2. Identify any customizable parameters (e.g., coordinates, tool IDs, numbers).
3. Write a clean Luau script to test or automate this remote safely.
]], rec.path, rec.remote.ClassName, rec.method, rec.lastArgs and (rec.lastArgs.n or #rec.lastArgs) or 0, argsFormatted)
    return prompt
end

local function generateExecutableCode(path, method, argsTable, loop)
    local n = type(argsTable) == "table" and (#argsTable) or 0
    local argsStr = {}
    if type(argsTable) == "table" then
        for i = 1, math.max(n, 1) do
            if argsTable[i] ~= nil then
                table.insert(argsStr, serializeValue(argsTable[i]))
            end
        end
    end
    local callStr = string.format("%s:%s(%s)", path, method, table.concat(argsStr, ", "))
    if loop then
        return string.format("task.spawn(function()\n    while true do\n        %s\n        task.wait(%.2f)\n    end\nend)", callStr, 1/autoRate)
    end
    return callStr
end

local function argsSummary(packed)
    if not packed then return "" end
    local n = packed.n or #packed
    if n == 0 then return "" end
    local out = {}
    for i = 1, math.min(n, 5) do
        table.insert(out, serializeValue(packed[i]))
    end
    return table.concat(out, ", ")
end

