-- ═══ Ultra-Fast Asynchronous Scheduler (Prevents Physics/Tool Lag) ═══
local function runScheduler()
    if head > #pending then return end
    for _ = 1, 6 do
        local job = pending[head]
        if not job then break end
        head = head + 1
        local remote, method, packed = job[1], job[2], job[3]
        if typeof(remote) == "Instance" and not CoreBlacklist[remote.Name] then
            local ok, name = pcall(function() return remote:GetFullName() end)
            if ok and name then
                addRow(name, remote, method, packed)
            end
        end
    end
    if head > 200 then
        local newP = {}
        for i = head, #pending do newP[#newP + 1] = pending[i] end
        pending = newP; head = 1
    end
end

-- ═══ Zero-Lag Hooking System ═══
local oldFN2
local function installHook()
    if getrawmetatable and setreadonly then
        local ok, mt = pcall(getrawmetatable, game)
        if ok and mt and mt.__namecall then
            local oldNC = mt.__namecall
            setreadonly(mt, false)
            mt.__namecall = function(self, ...)
                local m = getnamecallmethod()
                if m == "FireServer" or m == "InvokeServer" then
                    -- Zero lag capture (No GetFullName inside hook!)
                    if not paused then
                        pending[#pending + 1] = {self, m, table.pack(...)}
                    end
                end
                return oldNC(self, ...)
            end
            setreadonly(mt, true)
            original = function(...) return oldNC(...) end
            return true, "getrawmetatable"
        end
    end

    if hookmetamethod then
        local ok, oldFN = pcall(function()
            return hookmetamethod(game, "__namecall", function(self, ...)
                local m = getnamecallmethod()
                if m == "FireServer" or m == "InvokeServer" then
                    if not paused then
                        pending[#pending + 1] = {self, m, table.pack(...)}
                    end
                end
                return oldFN2(self, ...)
            end)
        end)
        if ok and oldFN then
            oldFN2 = oldFN
            original = function(...) return oldFN(...) end
            return true, "hookmetamethod"
        end
    end
    return false, "No Hook"
end

local function removeHook()
    if autoFireTask then task.cancel(autoFireTask) end
    if not original then return end
    pcall(function()
        if getrawmetatable and setreadonly then
            local mt = getrawmetatable(game)
            setreadonly(mt, false)
            mt.__namecall = original
            setreadonly(mt, true)
        end
    end)
    original = nil
end

local function shutdown()
    removeHook()
    if sg then sg:Destroy() end
    _G.VANTA_SPY_SHUTDOWN = nil
end
_G.VANTA_SPY_SHUTDOWN = shutdown

