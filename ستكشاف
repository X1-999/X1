-- ═══ DETECT HELD PART ═══
local function getHeldPart()
    local gp = workspace:FindFirstChild("GrabParts")
    if not gp then return nil end
    local grabPart = gp:FindFirstChild("GrabPart")
    if not grabPart then return nil end
    local weld = grabPart:FindFirstChild("WeldConstraint")
    if not weld then return nil end
    return weld.Part1
end

-- ═══ FORMAT HELPERS ═══
local function n(v) return string.format("%.3f", v) end
local function vec3(v) return string.format("Vector3.new(%.3f, %.3f, %.3f)", v.X, v.Y, v.Z) end
local function rgb(c) return string.format("Color3.fromRGB(%d, %d, %d)",
    math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5)) end

local function shapeOf(p)
    if p:IsA("Part") then
        local s = tostring(p.Shape):gsub("Enum.PartType.", "")
        return s
    elseif p:IsA("MeshPart") then return "MeshPart"
    elseif p:IsA("WedgePart") then return "Wedge"
    elseif p:IsA("TrussPart") then return "Truss"
    elseif p:IsA("CornerWedgePart") then return "CornerWedge"
    else return p.ClassName end
end

-- ═══ BUILD REPORT ═══
local function buildReport(part)
    local L = {}
    local function add(s) L[#L+1] = s end

    local model = part:FindFirstAncestorOfClass("Model")

    add("═══════════════════════════════════════════")
    add("  PART: "..part.Name.."  ["..part.ClassName.."]")
    if model then add("  MODEL: "..model.Name) end
    add("  PATH: "..part:GetFullName())
    add("═══════════════════════════════════════════")
    add("")

    add("── SIZE ──")
    add("  X (width)  = "..n(part.Size.X))
    add("  Y (height) = "..n(part.Size.Y))
    add("  Z (depth)  = "..n(part.Size.Z))
    add("  Vector3    = "..vec3(part.Size))
    add("")

    add("── SHAPE ──")
    add("  "..shapeOf(part))
    add("")

    add("── COLOR ──")
    add("  "..rgb(part.Color))
    add("  R="..math.floor(part.Color.R*255+0.5).." G="..math.floor(part.Color.G*255+0.5).." B="..math.floor(part.Color.B*255+0.5))
    add("  BrickColor: "..tostring(part.BrickColor))
    add("")

    add("── MATERIAL & SURFACE ──")
    add("  Material:    "..tostring(part.Material))
    add("  Reflectance: "..n(part.Reflectance))
    add("  Transparency: "..n(part.Transparency))
    add("")

    add("── PHYSICS ──")
    add("  Anchored:   "..tostring(part.Anchored))
    add("  CanCollide: "..tostring(part.CanCollide))
    add("  CanQuery:   "..tostring(part.CanQuery))
    add("  CanTouch:   "..tostring(part.CanTouch))
    add("  Massless:   "..tostring(part.Massless))
    add("  AssemblyMass: "..n(part.AssemblyMass))
    add("")

    add("── ORIENTATION (current CFrame) ──")
    local pos = part.Position
    local rx, ry, rz = part.CFrame:ToEulerAnglesXYZ()
    add("  Position: ("..n(pos.X)..", "..n(pos.Y)..", "..n(pos.Z)..")")
    add("  Rotation (deg): X="..math.floor(math.deg(rx)+0.5).." Y="..math.floor(math.deg(ry)+0.5).." Z="..math.floor(math.deg(rz)+0.5))
    add("")

    if model then
        add("── MODEL PARTS ("..#model:GetDescendants().." descendants) ──")
        local count = 0
        for _, d in ipairs(model:GetDescendants()) do
            if d:IsA("BasePart") then
                count = count + 1
                add(string.format("  %2d) %-25s %-12s size=(%s, %s, %s)",
                    count,
                    d.Name,
                    d.ClassName,
                    n(d.Size.X), n(d.Size.Y), n(d.Size.Z)))
            end
        end
        add("")
        add("  Total BaseParts in model: "..count)
        add("")
    end

    add("── QUICK REBUILD RECIPE ──")
    add(string.format('local p = Instance.new("%s")', part.ClassName))
    add('p.Name = "'..part.Name..'"')
    add("p.Size = "..vec3(part.Size))
    add("p.Color = "..rgb(part.Color))
    add("p.Material = Enum.Material."..tostring(part.Material))
    if part:IsA("Part") then
        add("p.Shape = Enum.PartType."..shapeOf(part))
    end
    add("p.CanCollide = "..tostring(part.CanCollide))
    add("p.Anchored = "..tostring(part.Anchored))
    add("")
    add("═══════════════════════════════════════════")

    return table.concat(L, "\n")
end

-- ═══ UI UPDATE ═══
local function refreshUI()
    local part = getHeldPart()
    if not part then
        currentPart = nil
        currentReport = ""
        if scroll then
            for _, c in ipairs(scroll:GetChildren()) do
                if c:IsA("TextLabel") then c:Destroy() end
            end
        end
        return
    end

    if part == currentPart then return end
    currentPart = part
    currentReport = buildReport(part)

    -- امسح القديم
    for _, c in ipairs(scroll:GetChildren()) do
        if c:IsA("TextLabel") then c:Destroy() end
    end

    -- اعرض الجديد
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -10, 0, 0)
    lbl.Position = UDim2.new(0, 5, 0, 5)
    lbl.AutomaticSize = Enum.AutomaticSize.Y
    lbl.BackgroundTransparency = 1
    lbl.TextColor3 = Color3.fromRGB(200, 255, 220)
    lbl.Font = Enum.Font.Code
    lbl.TextSize = 10
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextYAlignment = Enum.TextYAlignment.Top
    lbl.TextWrapped = true
    lbl.Text = currentReport
    lbl.Parent = scroll

    -- انسخ تلقائيًا
    if setclipboard then
        setclipboard(currentReport)
    end
end

addConn(RunService.Heartbeat:Connect(function()
    local now = tick()
    if (now - lastScan) > 0.3 then
        lastScan = now
        refreshUI()
    end
end))

-- ═══ SHUTDOWN ═══
local function shutdown()
    for _, c in ipairs(CONNECTIONS) do pcall(function() c:Disconnect() end) end
    CONNECTIONS = {}
    if sg then pcall(function() sg:Destroy() end); sg = nil end
    local lo = PG:FindFirstChild("VANTA_Dim")
    if lo then pcall(function() lo:Destroy() end) end
    _G.VANTA_DIM_SHUTDOWN = nil
end
_G.VANTA_DIM_SHUTDOWN = shutdown

